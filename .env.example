# Copy to .env for local development. Loaded automatically by `booksync serve`.

BOOKSYNC_DATA_DIR=./data
BOOKSYNC_PORT=8686
BOOKSYNC_LOG_LEVEL=info

# Optional: pre-fill the "Add Kindle Account" form's TLS proxy URL/key.
# Useful when both booksync and its tls-client-api sidecar are defined in the
# same docker-compose file/`.env`, so that shared key doesn't have to be
# hand-copied into the UI. Purely a form default; can always be overridden.
# BOOKSYNC_DEFAULT_TLS_PROXY_URL=http://booksync-tls-proxy:8080
# BOOKSYNC_DEFAULT_TLS_PROXY_KEY=change-me
